# ---------------------------------------------------------------------------
# SECRETS AND SESSION STATE — must never be committed
# ---------------------------------------------------------------------------
# The logged-in browser session. This file IS a credential: it holds the
# LinkedIn cookies (and, if exported from a normal browser, Google cookies too).
browser_profile/
storage.json
*.storage.json

# Any local env / config files.
.env
.env.*
!.env.example
config.yaml

# ---------------------------------------------------------------------------
# Runtime state written by the poster
# ---------------------------------------------------------------------------
content/schedule_run.lock
content/*.lock

# Local safety copies made by scripts/repair_phantoms.py.  Never committed:
# they duplicate post text that is already in posts_sent.txt.
content/_backup_repair/
content/_backup_*/
logs/
*.log

# ---------------------------------------------------------------------------
# Backups and scratch copies
# ---------------------------------------------------------------------------
*.bak
*.bak_*
*_preview.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
